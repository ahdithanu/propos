# Copy to .env.local. Never commit real values.

# live | staging | test. staging rewrites every outbound recipient to the owner.
PROPOPS_MODE=test

# Local Supabase (`npm run db:start` prints these). Service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Needed for a real agent run and for evals. Tests use a scripted model and need no key.
ANTHROPIC_API_KEY=

# Phase 1b: Inngest dev server needs no keys locally; these are for deploy.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Phase 5 (real integrations). Leave empty; mocks are used until then.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The exact public URL Twilio calls, if it differs from what the app sees behind a proxy.
TWILIO_WEBHOOK_URL=
